function calc() {
    let n1 = parseFloat(prompt("Digite o primeiro número:"));
    let n2 = parseFloat(prompt("Digite o segundo número:"));
    let car = prompt("Digite o caractere da operação (+, -, *, /):");
    let res;

    switch (car) {
        case '+':
            res = n1 + n2;
            break;
        case '-':
            res = n1 - n2;
            break;
        case '*':
            res = n1 * n2;
            break;
        case '/':
            if (n2 !== 0) {
                res = n1 / n2;
            } else {
                alert("Erro: Divisão por zero");
                return;
            }
            break;
        default:
            alert("Operação inválida");
            return;
    }

    console.log(`Resultado: ${res}`);
}

calc();

function totPed() {
    let cod = parseInt(prompt("Digite o código do item (100 a 105):"));
    let qtd = parseInt(prompt("Digite a quantidade adquirida:"));
    let prc = 0;

    switch (cod) {
        case 100: prc = 1.70; break;
        case 101: prc = 2.30; break;
        case 102: prc = 2.60; break;
        case 103: prc = 2.40; break;
        case 104: prc = 2.50; break;
        case 105: prc = 1.00; break;
        default:
            alert("Código de produto inválido.");
            return;
    }

    let vF = prc * qtd;
    console.log(`R$ ${vF.toFixed(2)}`);
}

totPed();

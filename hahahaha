
function classProd() {
    let cod = parseInt(prompt("Digite o código do produto:"));
    let cls;

    switch (cod) {
        case 1:
            cls = "Alimento não-perecível";
            break;
        case 2:
        case 3:
        case 4:
            cls = "Alimento perecível";
            break;
        case 5:
        case 6:
            cls = "Vestuário";
            break;
        case 7:
            cls = "Higiene Pessoal";
            break;
        default:
            if (cod >= 8 && cod <= 15) {
                cls = "Limpeza e Utensílios Domésticos";
            } else {
                alert("Código inválido");
                return;
            }
            break;
    }

    console.log(`Classificação: ${cls}`);
}

classProd();

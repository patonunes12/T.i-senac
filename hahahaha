function menuOp() {
    let n1 = parseFloat(prompt("Digite o primeiro número:"));
    let n2 = parseFloat(prompt("Digite o segundo número:"));
    let esc = parseInt(prompt("Escolha a operação:\n1 - Média\n2 - Diferença\n3 - Produto\n4 - Divisão"));
    let res;

    switch (esc) {
        case 1:
            res = (n1 + n2) / 2;
            console.log(`Média: ${res}`);
            break;
        case 2:
            res = Math.abs(n1 - n2);
            console.log(`Diferença: ${res}`);
            break;
        case 3:
            res = n1 * n2;
            console.log(`Produto: ${res}`);
            break;
        case 4:
            if (n2 !== 0) {
                res = n1 / n2;
                console.log(`Divisão do primeiro pelo segundo: ${res}`);
            } else {
                alert("Erro: O segundo número não pode ser zero.");
            }
            break;
        default:
            alert("Erro: Opção inválida. Execução terminada.");
            return;
    }
}


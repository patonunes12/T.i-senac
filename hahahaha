<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Barra de Filtros Moderna</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<div class="container">

    <div class="barra-filtros">
        <div class="grupo-filtro">
            <label for="buscaNome">O que você procura?</label>
            <input type="text" id="buscaNome" class="filtro-input" placeholder="Digite o nome...">
        </div>
        
        <div class="grupo-filtro">
            <label for="buscaCategoria">Categoria</label>
            <select id="buscaCategoria" class="filtro-input">
                <option value="todos">Todas as categorias</option>
                <option value="tecnologia">Tecnologia</option>
                <option value="casa">Casa & Banho</option>
                <option value="esporte">Esportes</option>
            </select>
        </div>
    </div>

    <div class="grade-produtos">
        <div class="card-produto" data-categoria="tecnologia">
            <h3>Teclado Mecânico</h3>
            <span class="tag-categoria">Tecnologia</span>
        </div>
        <div class="card-produto" data-categoria="casa">
            <h3>Jogo de Toalhas</h3>
            <span class="tag-categoria">Casa & Banho</span>
        </div>
        <div class="card-produto" data-categoria="esporte">
            <h3>Bola de Futebol</h3>
            <span class="tag-categoria">Esportes</span>
        </div>
        <div class="card-produto" data-categoria="tecnologia">
            <h3>Mouse Gamer</h3>
            <span class="tag-categoria">Tecnologia</span>
        </div>
        <div class="card-produto" data-categoria="casa">
            <h3>Luminária de Mesa</h3>
            <span class="tag-categoria">Casa & Banho</span>
        </div>
    </div>

</div>

<script src="script.js"></script>
</body>
</html>

* { 
    margin: 0; 
    padding: 0; 
    box-sizing: border-box; 
    font-family: 'Segoe UI', sans-serif; 
}

body { 
    background-color: #f0f2f5; 
    padding: 40px 20px; 
    color: #333; 
}

.container { 
    max-width: 1000px; 
    margin: 0 auto; 
}

.barra-filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    background: #ffffff;
    padding: 20px;
    border-radius: 12px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    margin-bottom: 30px;
}

.grupo-filtro { 
    display: flex; 
    flex-direction: column; 
    flex: 1; 
    min-width: 200px; 
}

.grupo-filtro label { 
    font-size: 14px; 
    font-weight: 600; 
    margin-bottom: 8px; 
    color: #666; 
}

.filtro-input {
    width: 100%;
    padding: 10px 14px;
    border: 2px solid #e0e0e0;
    border-radius: 8px;
    font-size: 15px;
    outline: none;
    transition: border-color 0.2s;
}

.filtro-input:focus { 
    border-color: #4a90e2; 
}

.grade-produtos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
}

.card-produto {
    background: #ffffff;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    border: 1px solid #eef0f2;
    transition: transform 0.3s, opacity 0.3s;
    opacity: 1;
    transform: scale(1);
}

.card-produto.escondido {
    display: none !important;
    opacity: 0;
    transform: scale(0.9);
}

.card-produto h3 { 
    font-size: 18px; 
    margin-bottom: 10px; 
    color: #222; 
}

.tag-categoria {
    display: inline-block;
    background: #e1f5fe;
    color: #0288d1;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
}





const inputNome = document.getElementById('buscaNome');
const selectCategoria = document.getElementById('buscaCategoria');
const cards = document.querySelectorAll('.card-produto');

function filtrarProdutos() {
    const termoBusca = inputNome.value.toLowerCase().trim();
    const categoriaSelecionada = selectCategoria.value;

    cards.forEach(card => {
        const nomeProduto = card.querySelector('h3').textContent.toLowerCase();
        const categoriaProduto = card.getAttribute('data-categoria');

        const bateuNome = nomeProduto.includes(termoBusca);
        const bateuCategoria = categoriaSelecionada === 'todos' || categoriaProduto === categoriaSelecionada;

        if (bateuNome && bateuCategoria) {
            card.classList.remove('escondido');
        } else {
            card.classList.add('escondido');
        }
    });
}

inputNome.addEventListener('input', filtrarProdutos);
selectCategoria.addEventListener('change', filtrarProdutos);





